{
  "name": "narv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:api": "node scripts/serve-backend.mjs",
    "deploy:api": "npx wrangler deploy --config backend/wrangler.toml",
    "db:migrate": "npx wrangler d1 migrations apply narv --remote --config backend/wrangler.toml",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@tanstack/query-core": "5.104.0",
    "esbuild": "0.28.1",
    "wrangler": "4.142.0"
  }
}
